DATABASE_URL=postgresql://oneinfo:oneinfo@localhost:55432/oneinfo
ONEINFO_POSTGRES_PORT=55432
# Optional private VPS database tunnel, managed and reconnected by Start Oneinfo.
# Use DATABASE_URL=postgresql://user:password@127.0.0.1:55434/oneinfo with these:
# ONEINFO_DATABASE_SSH=root@your-vps-host
# ONEINFO_DATABASE_CONTAINER=oneinfo-vps-postgres-1
PORT=3001
HOST=127.0.0.1
# Encrypted direct phone connection on the private LAN (desktop HTTP remains loopback-only).
NFC_LAN_PORT=3443
JWT_SECRET=replace-with-at-least-32-random-characters
# Local card activation/profile pages; replace with your hosted HTTPS /c URL before printing customer cards.
PUBLIC_CARD_BASE_URL=http://127.0.0.1:5174/c
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
DEV_ADMIN_EMAIL=admin@oneinfo.local
# Hosted Admin sign-in. Generate a salted scrypt hash; never put the password in VITE_* variables.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=scrypt:<32 hex salt>:<128 hex hash>
# Keep disposable tests on local PostgreSQL when DATABASE_URL points to the cloud.
TEST_DATABASE_URL=postgresql://oneinfo:oneinfo@localhost:55432/oneinfo
VITE_API_URL=http://localhost:3001

# Optional Brevo order emails. Use a verified sender and an SMTP key.
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# ORDER_EMAIL_FROM="Oneinfo <no-reply@oneinfo.online>"
# Resend is used if Brevo SMTP is not configured.
# RESEND_API_KEY=
# STOREFRONT_URL=https://oneinfo.example
# CRM_LEAD_WEBHOOK_URL=https://crm.example/hooks/oneinfo
# CRM_LEAD_WEBHOOK_TOKEN=your-webhook-token
