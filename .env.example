DATABASE_URL=postgresql://oneinfo:oneinfo@localhost:55432/oneinfo
ONEINFO_POSTGRES_PORT=55432
PORT=3001
HOST=127.0.0.1
JWT_SECRET=replace-with-at-least-32-random-characters
# Local card activation/profile pages; replace with your hosted HTTPS /c URL before printing customer cards.
PUBLIC_CARD_BASE_URL=http://127.0.0.1:5174/c
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
DEV_ADMIN_EMAIL=admin@oneinfo.local
# Hosted Admin sign-in. Generate a salted scrypt hash; never put the password in VITE_* variables.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=scrypt:<32 hex salt>:<128 hex hash>
# Keep disposable tests on local PostgreSQL when DATABASE_URL points to the cloud.
TEST_DATABASE_URL=postgresql://oneinfo:oneinfo@localhost:55432/oneinfo
VITE_API_URL=http://localhost:3001

# Optional order confirmations. Use an email address on your verified Resend domain.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Oneinfo <orders@example.com>
# STOREFRONT_URL=https://oneinfo.example
