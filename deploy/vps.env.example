# Copy to .env.vps at the repository root. Never commit the real file.
# Use a generated HEX password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-hex-password
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_CARD_BASE_URL=https://oneinfo.online/c
CORS_ORIGIN=https://oneinfo.online,https://www.oneinfo.online
STOREFRONT_URL=https://oneinfo.online
ADMIN_EMAIL=admin@oneinfo.online
# Generate using the instructions in deploy/VPS.md.
# ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Exactly one trusted reverse proxy; it must overwrite X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Optional transactional email:
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Oneinfo <orders@oneinfo.online>
