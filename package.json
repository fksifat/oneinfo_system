{
  "name": "oneinfo-production-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:cloud": "node scripts/build-cloud.mjs",
    "build": "npm run build --workspace @oneinfo/contracts && npm run build --workspace @oneinfo/api && npm run build --workspace @oneinfo/production-console && npm run build --workspace @oneinfo/control-center && npm run build:storefront",
    "dev": "npm run dev:api",
    "dev:api": "npm run dev --workspace @oneinfo/api",
    "dev:console": "npm run dev --workspace @oneinfo/production-console",
    "dev:control": "npm run dev --workspace @oneinfo/control-center",
    "dev:storefront": "vite sites/storefront --host 127.0.0.1 --port 5175 --strictPort",
    "nfc:desktop": "npm run start --workspace @oneinfo/desktop-nfc-bridge --",
    "android:usb": "bash scripts/connect-android-nfc.sh",
    "db:generate": "npm run db:generate --workspace @oneinfo/api",
    "db:migrate": "npm run db:migrate --workspace @oneinfo/api",
    "db:push": "npm run db:push --workspace @oneinfo/api",
    "smoke": "npm run test:printed-stock",
    "test": "npm run test --workspaces --if-present && node --test scripts/storefront.test.mjs scripts/launcher.test.mjs scripts/hosting.test.mjs scripts/smoke-guard.test.mjs",
    "typecheck": "npm run typecheck --workspace @oneinfo/contracts && npm run typecheck --workspace @oneinfo/api && npm run typecheck --workspace @oneinfo/production-console && npm run typecheck --workspace @oneinfo/control-center",
    "build:storefront": "vite build sites/storefront",
    "predev:api": "npm run build --workspace @oneinfo/contracts",
    "desktop": "node scripts/desktop.mjs",
    "start:local": "node scripts/start-local.mjs",
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "test:launcher": "node --test scripts/launcher.test.mjs",
    "test:printed-stock": "npm run build --workspace @oneinfo/contracts && node scripts/test-printed-stock.mjs",
    "test:ui": "npm run build && node scripts/ui-check.mjs",
    "pretest": "npm run build --workspace @oneinfo/contracts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@google/model-viewer": "4.1.0"
  }
}
