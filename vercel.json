{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:cloud",
  "outputDirectory": ".cloud-dist",
  "regions": ["sin1"],
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/admin", "destination": "/dashboard/index.html" },
    { "source": "/admin/:path*", "destination": "/dashboard/index.html" },
    { "source": "/c/:path*", "destination": "/dashboard/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
