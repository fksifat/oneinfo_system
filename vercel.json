{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:cloud",
  "outputDirectory": ".cloud-dist",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://api.oneinfo.online/api/v1/:path*" },
    { "source": "/health", "destination": "https://api.oneinfo.online/health" },
    { "source": "/admin", "destination": "/dashboard/index.html" },
    { "source": "/admin/:path*", "destination": "/dashboard/index.html" },
    { "source": "/team", "destination": "/dashboard/index.html" },
    { "source": "/c/:path*", "destination": "/dashboard/index.html" },
    { "source": "/:handle([a-zA-Z0-9]{1,64})", "destination": "/dashboard/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
